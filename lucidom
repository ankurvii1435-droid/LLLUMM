/* ═══════════════════════════════════════
   MEDITATION CARD — Flip + Audio Player
═══════════════════════════════════════ */

// ——— Build animated waveform bars ———
(function buildWave() {
  const viz = document.getElementById('waveViz');
  if (!viz) return;
  const numBars = 28;
  for (let i = 0; i < numBars; i++) {
    const bar = document.createElement('div');
    const h = 8 + Math.random() * 32;
    bar.style.cssText = `
      width:3px; height:${h}px; border-radius:2px;
      background:linear-gradient(180deg,#67E8F9,#06B6D4);
      opacity:0.35;
      transition:height 0.18s ease, opacity 0.18s ease;
      transform-origin:center;
    `;
    bar.dataset.base = h;
    bar.dataset.idx = i;
    viz.appendChild(bar);
  }
})();

// ——— Flip card ———
function flipMedCard(el) {
  const flipped = el.style.transform === 'rotateY(180deg)';
  el.style.transform = flipped ? 'rotateY(0deg)' : 'rotateY(180deg)';
}

// ——— Simulated audio state ———
let medPlaying = false;
let medTimeSec = 0;
const medTotalSec = 720; // 12 minutes
let medInterval = null;
let waveInterval = null;

// Script segment timestamps (seconds)
const scriptTimes = [0, 120, 240, 360, 510, 630];

function togglePlay() {
  medPlaying = !medPlaying;
  document.getElementById('playIcon').style.display  = medPlaying ? 'none'  : 'block';
  document.getElementById('pauseIcon').style.display = medPlaying ? 'block' : 'none';

  if (medPlaying) {
    // Tick timer
    medInterval = setInterval(() => {
      medTimeSec = Math.min(medTimeSec + 1, medTotalSec);
      updateProgress();
      highlightScript();
      if (medTimeSec >= medTotalSec) { medPlaying = false; clearInterval(medInterval); clearInterval(waveInterval); resetBars(); }
    }, 1000);
    // Animate waveform
    waveInterval = setInterval(animateBars, 120);
  } else {
    clearInterval(medInterval);
    clearInterval(waveInterval);
    resetBars();
  }
}

function updateProgress() {
  const pct = (medTimeSec / medTotalSec) * 100;
  const fill = document.getElementById('progFill');
  const thumb = document.getElementById('progThumb');
  const cur = document.getElementById('curTime');
  if (fill) fill.style.width = pct + '%';
  if (thumb) thumb.style.left = pct + '%';
  if (cur) {
    const m = Math.floor(medTimeSec / 60);
    const s = String(medTimeSec % 60).padStart(2, '0');
    cur.textContent = `${m}:${s}`;
  }
}

function seekAudio(e, track) {
  const rect = track.getBoundingClientRect();
  const pct = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
  medTimeSec = Math.round(pct * medTotalSec);
  updateProgress();
  highlightScript();
}

function skipAudio(sec) {
  medTimeSec = Math.max(0, Math.min(medTotalSec, medTimeSec + sec));
  updateProgress();
  highlightScript();
}

function setVol(v) {
  // Update slider gradient
  const sl = document.getElementById('volSlider');
  if (sl) sl.style.background = `linear-gradient(90deg,#67E8F9 ${v}%,rgba(165,180,252,0.2) ${v}%)`;
}

function animateBars() {
  const bars = document.querySelectorAll('#waveViz div');
  bars.forEach(bar => {
    const base = parseFloat(bar.dataset.base);
    const delta = (Math.random() - 0.5) * 18;
    const newH = Math.max(4, Math.min(48, base + delta));
    bar.style.height = newH + 'px';
    bar.style.opacity = 0.5 + Math.random() * 0.5;
  });
}

function resetBars() {
  const bars = document.querySelectorAll('#waveViz div');
  bars.forEach(bar => {
    bar.style.height = bar.dataset.base + 'px';
    bar.style.opacity = '0.35';
  });
}

function highlightScript() {
  let activeIdx = 0;
  scriptTimes.forEach((t, i) => { if (medTimeSec >= t) activeIdx = i; });
  for (let i = 0; i < scriptTimes.length; i++) {
    const seg = document.getElementById('s' + i);
    if (!seg) continue;
    if (i === activeIdx) {
      seg.style.background = 'rgba(103,232,249,0.08)';
      seg.style.borderLeft = '2px solid rgba(103,232,249,0.5)';
      seg.style.paddingLeft = '12px';
      seg.style.color = 'rgba(224,231,255,0.85)';
      // Scroll into view inside the container
      const container = document.getElementById('scriptScroll');
      if (container) {
        const offset = seg.offsetTop - container.offsetTop - 20;
        container.scrollTo({ top: offset, behavior: 'smooth' });
      }
    } else {
      seg.style.background = 'transparent';
      seg.style.borderLeft = 'none';
      seg.style.paddingLeft = '10px';
      seg.style.color = 'rgba(165,180,252,0.55)';
    }
  }
}
</script>

