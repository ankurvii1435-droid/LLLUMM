<script>
/* ——— Starfield ——— */
const sf = document.getElementById('sf');
const ctx = sf.getContext('2d');
let stars = [], W, H;
function rsz() {
  const h = sf.parentElement;
  W = sf.width = h.offsetWidth;
  H = sf.height = h.offsetHeight;
}
rsz(); window.addEventListener('resize', () => { rsz(); mkStars(); });
function mkStars() {
  stars = [];
  for (let i = 0; i < Math.floor(W*H/3600); i++) {
    stars.push({ x:Math.random()*W, y:Math.random()*H,
      r:Math.random()*1.2+0.2, op:Math.random()*0.7+0.1,
      tw:Math.random()*0.025+0.006, off:Math.random()*Math.PI*2,
      c:Math.random()>.82?'#67E8F9':Math.random()>.5?'#A5B4FC':'#E0E7FF'
    });
  }
}
mkStars();
let t=0;
(function anim() {
  ctx.clearRect(0,0,W,H); t+=0.016;
  stars.forEach(s => {
    const a = s.op*(0.4+0.6*Math.sin(t*s.tw*60+s.off));
    ctx.beginPath(); ctx.arc(s.x,s.y,s.r,0,Math.PI*2);
    ctx.fillStyle=s.c; ctx.globalAlpha=a; ctx.fill();
  });
  ctx.globalAlpha=1; requestAnimationFrame(anim);
})();

/* ——— Nav color change on scroll ——— */
const nav = document.getElementById('nav');
const nLogo = document.getElementById('nLogo');
const nLinks = document.querySelectorAll('.nl');
let heroH = document.querySelector('.hero').offsetHeight;
let isLight = false;

window.addEventListener('scroll', () => {
  const past = window.scrollY > heroH - 80;
  if (past && !isLight) {
    isLight = true;
    nav.className = 'n-light';
    nLogo.style.color = '#12102B';
    nLinks.forEach(l => {
      l.style.color = 'rgba(18,16,43,0.58)';
      l.onmouseover = () => l.style.color = '#4F46E5';
      l.onmouseout  = () => l.style.color = 'rgba(18,16,43,0.58)';
    });
  } else if (!past && isLight) {
    isLight = false;
    nav.className = 'n-dark';
    nLogo.style.color = '#E0E7FF';
    nLinks.forEach(l => {
      l.style.color = 'rgba(165,180,252,0.75)';
      l.onmouseover = () => l.style.color = '#E0E7FF';
      l.onmouseout  = () => l.style.color = 'rgba(165,180,252,0.75)';
    });
  }
});

/* ——— Scroll reveals ——— */
const revEls = document.querySelectorAll('.reveal');
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); obs.unobserve(e.target); }
  });
}, { threshold: 0.1 });
revEls.forEach((el,i) => {
  el.style.transitionDelay = (i%4)*0.08+'s';
  obs.observe(el);
});

/* ——— Billing toggle ——— */
function setToggle(mode) {
  const mo = document.getElementById('tMo');
  const yr = document.getElementById('tYr');
  const amt = document.getElementById('pAmt');
  const per = document.getElementById('pPer');
  const sub = document.getElementById('pSub');
  const save = document.getElementById('pSave');
  if (mode === 'mo') {
    mo.classList.add('on'); yr.classList.remove('on');
    mo.style.color = '#4F46E5'; yr.style.color = 'rgba(165,180,252,0.6)';
    amt.textContent = '$125'; per.textContent = '/month';
    sub.textContent = ''; save.style.display = 'none';
  } else {
    yr.classList.add('on'); mo.classList.remove('on');
    yr.style.color = '#4F46E5'; mo.style.color = 'rgba(165,180,252,0.6)';
    amt.textContent = '$1,200'; per.textContent = '/year';
    sub.textContent = 'That\'s just $100/month — save $300'; save.style.display = 'block';
  }
}

