<script>
/* ═══════════════════════════════════════
   REALITY CHECK PACK — JS
═══════════════════════════════════════ */
const rcData = [
  { title:'The Lunar Gate',   cat:'Cosmos',    q:'"Look at your hands. Count your fingers."',        desc:'The oldest and most reliable reality check. In dreams, hands often appear distorted — too many fingers, shifting numbers, strange textures. Make this a waking habit and it will naturally appear in your dreams.' },
  { title:'Star River',       cat:'Cosmos',    q:'"Can you read this text twice?"',                  desc:'Text in dreams is notoriously unstable. Try reading the same sentence twice — if the words shift or blur, you are dreaming. The dream brain cannot maintain consistent language.' },
  { title:'The Lotus',        cat:'Tibetan',   q:'"Does this feel real or like a dream?"',           desc:'The most fundamental Tibetan Dream Yoga inquiry. Rather than a mechanical test, this is a contemplative pause — a moment of sincere inquiry into the nature of your experience right now.' },
  { title:'Flower of Life',   cat:'Geometric', q:'"Are the shapes around you stable?"',             desc:'In waking life, physical geometry is fixed. In dreams, angles shift, straight lines curve, and patterns breathe. Study the edges and corners around you — train the mind to notice dreamlike instability.' },
  { title:'Forest Portal',    cat:'Nature',    q:'"When did you arrive here?"',                     desc:'Dreams always begin mid-scene — you never have a memory of arrival. Ask yourself: how did I get here? Trace your steps backward. If you cannot, the scene may be a dream.' },
  { title:'The Gateway',      cat:'Geometric', q:'"Where does this door lead?"',                   desc:'Doors in dreams often open to impossible places. Before passing through any threshold, pause and ask what is on the other side. Your answer reveals which world you are in.' },
  { title:'Ocean Mirror',     cat:'Nature',    q:'"Which reflection is the real one?"',             desc:'Mirrors behave strangely in dreams — your reflection may not match your actions, or may not be there at all. Touch your face. Check a reflective surface. The solid world confirms itself.' },
  { title:'Dharma Wheel',     cat:'Tibetan',   q:'"Plug your nose. Can you breathe?"',              desc:'The nose-plug check is one of the most reliable techniques. Pinch your nose closed and try to breathe through it. In a dream, you will still be able to breathe — a clear, unmistakable signal.' },
  { title:'Cosmic Spiral',    cat:'Cosmos',    q:'"Jump up. Do you float back slowly?"',            desc:'Gravity in dreams is unreliable. A small hop can launch you into extended floating. Try a gentle jump — notice whether you return at normal speed, or drift slowly back like a leaf in water.' },
  { title:'The Awakening',    cat:'Tibetan',   q:'"Say: I am awake. I am aware. I am dreaming."',  desc:'This is the core affirmation of Tibetan Dream Yoga. Saying it sincerely — not just reciting — creates a moment of genuine inquiry. In a dream, this statement may trigger full lucid awareness.' }
];

let rcCurrentLB = 0;

// Open / close panel
function openWallpaperPanel() {
  const p = document.getElementById('rcPanel');
  p.classList.add('rc-open');
  p.scrollTop = 0;
  document.body.style.overflow = 'hidden';
  setTimeout(() => { document.getElementById('rcPanelLbl').style.display = 'block'; }, 600);
}
function closeWallpaperPanel() {
  document.getElementById('rcPanel').classList.remove('rc-open');
  document.body.style.overflow = '';
  rcCloseLB();
}

// Filter
function rcFilter(cat, btn) {
  document.querySelectorAll('.rc-filter-btn').forEach(b => b.classList.remove('rc-on'));
  btn.classList.add('rc-on');
  document.querySelectorAll('.rc-wcard').forEach(c => {
    c.style.display = (cat === 'all' || c.dataset.rcat === cat) ? '' : 'none';
  });
}

// Lightbox
function rcOpenLB(idx) {
  rcCurrentLB = idx;
  const frames = document.querySelectorAll('#rcPanel .rc-phone-frame');
  const d = rcData[idx];
  document.getElementById('rcLbNum').textContent   = String(idx+1).padStart(2,'0') + ' / 10 · ' + d.cat;
  document.getElementById('rcLbTitle').textContent = d.title;
  document.getElementById('rcLbQ').textContent     = d.q;
  document.getElementById('rcLbDesc').textContent  = d.desc;
  // Clone the SVG
  const lb = document.getElementById('rcLbPhone');
  lb.innerHTML = frames[idx] ? frames[idx].innerHTML : '';
  lb.style.aspectRatio = '9/19.5';
  document.getElementById('rcLightbox').classList.add('rc-lb-open');
}
function rcCloseLB() {
  document.getElementById('rcLightbox').classList.remove('rc-lb-open');
}
function rcNavLB(dir) {
  rcCurrentLB = (rcCurrentLB + dir + 10) % 10;
  rcOpenLB(rcCurrentLB);
}

// Download as SVG
function rcDownload(idx) {
  const frames = document.querySelectorAll('#rcPanel .rc-phone-frame');
  if (!frames[idx]) return;
  const svgEl = frames[idx].querySelector('svg');
  if (!svgEl) return;
  const clone = svgEl.cloneNode(true);
  clone.setAttribute('width','1080');
  clone.setAttribute('height','2340');
  const str  = new XMLSerializer().serializeToString(clone);
  const blob = new Blob([str], { type:'image/svg+xml' });
  const url  = URL.createObjectURL(blob);
  const a    = document.createElement('a');
  a.href     = url;
  a.download = `lucid-om-rc-${String(idx+1).padStart(2,'0')}-${rcData[idx].title.toLowerCase().replace(/\s+/g,'-')}.svg`;
  a.click();
  URL.revokeObjectURL(url);
}

// Keyboard support
document.addEventListener('keydown', e => {
  const lbOpen = document.getElementById('rcLightbox').classList.contains('rc-lb-open');
  const panelOpen = document.getElementById('rcPanel').classList.contains('rc-open');
  if (!panelOpen) return;
  if (e.key === 'Escape') { lbOpen ? rcCloseLB() : closeWallpaperPanel(); }
  if (lbOpen) {
    if (e.key === 'ArrowRight') rcNavLB(1);
    if (e.key === 'ArrowLeft')  rcNavLB(-1);
  }
});
</script>

