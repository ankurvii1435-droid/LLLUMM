.cp-user-icon{background:rgba(165,180,252,0.12);border:1px solid rgba(165,180,252,0.2);color:rgba(165,180,252,0.65);font-size:9px;}
.cp-bubble{max-width:80%;padding:9px 12px;border-radius:14px;font-size:13px;line-height:1.6;}
.cp-bot-bubble{background:rgba(30,22,58,0.9);border:1px solid rgba(165,180,252,0.13);color:rgba(224,231,255,0.85);border-bottom-left-radius:4px;}
.cp-user-bubble{background:rgba(79,70,229,0.45);border:1px solid rgba(79,70,229,0.35);color:#E0E7FF;border-bottom-right-radius:4px;}
.cp-bot-bubble strong{color:#A5B4FC;}
.cp-bot-bubble em{color:rgba(103,232,249,0.8);font-style:italic;}
#cpTyping{display:none;gap:7px;}
.cp-typing-bubble{background:rgba(30,22,58,0.9);border:1px solid rgba(165,180,252,0.13);border-bottom-left-radius:4px;padding:10px 13px;border-radius:14px;display:flex;gap:4px;align-items:center;}
.cp-td{width:6px;height:6px;border-radius:50%;background:rgba(165,180,252,0.45);animation:cpBounce 1.2s ease-in-out infinite;}
.cp-td:nth-child(2){animation-delay:0.18s;}.cp-td:nth-child(3){animation-delay:0.36s;}
@keyframes cpBounce{0%,80%,100%{transform:translateY(0);opacity:0.4;}40%{transform:translateY(-4px);opacity:1;}}
#cpQuick{padding:0 12px 8px;display:flex;gap:5px;flex-wrap:wrap;flex-shrink:0;}
.cp-qbtn{font-size:11px;padding:5px 11px;border-radius:20px;background:rgba(79,70,229,0.1);border:1px solid rgba(79,70,229,0.22);color:rgba(165,180,252,0.7);cursor:pointer;transition:all 0.2s;font-family:'DM Sans',sans-serif;white-space:nowrap;}
.cp-qbtn:hover{background:rgba(79,70,229,0.22);color:#E0E7FF;}
#cpInputArea{padding:10px 12px 12px;border-top:1px solid rgba(165,180,252,0.09);background:rgba(10,15,30,0.88);display:flex;gap:8px;align-items:flex-end;flex-shrink:0;}
#cpInput{flex:1;background:rgba(30,22,58,0.8);border:1px solid rgba(165,180,252,0.15);border-radius:18px;padding:8px 13px;font-size:13px;color:#E0E7FF;outline:none;resize:none;font-family:'DM Sans',sans-serif;line-height:1.5;max-height:80px;overflow-y:auto;transition:border-color 0.22s;}
#cpInput::placeholder{color:rgba(165,180,252,0.28);}
#cpInput:focus{border-color:rgba(79,70,229,0.45);}
#cpSend{width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#4F46E5,#6D63F0);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all 0.22s;box-shadow:0 3px 12px rgba(79,70,229,0.35);}
#cpSend:hover{transform:scale(1.08);}
#cpSend:disabled{opacity:0.4;cursor:not-allowed;transform:none;}
</style>

<!-- Floating Bubble -->
<button id="chatBubble" onclick="toggleChat()" title="Chat with Lumina">
  <span style="font-size:20px;color:rgba(224,231,255,0.9);">ॐ</span>
  <span class="cb-badge"></span>
</button>

<!-- Chat Panel -->
<div id="chatPanel">
  <div id="cpHeader">
    <div id="cpAvatar">ॐ</div>
    <div style="flex:1">
      <div id="cpName">Lumina — Lucid Om Guide</div>
      <div id="cpStatus"><span class="cp-sdot"></span>Present · Always listening</div>
    </div>
    <button id="cpClose" onclick="toggleChat()">✕</button>
  </div>
  <div id="cpMsgs">
    <div class="cp-row bot">
      <div class="cp-icon cp-bot-icon">ॐ</div>
      <div class="cp-bubble cp-bot-bubble"><em>Welcome, dreamer.</em> I'm <strong>Lumina</strong>. Ask me anything about lucid dreaming, Dream Yoga, or the Lucid Om app.</div>
    </div>
    <div id="cpTyping" class="cp-row bot">
      <div class="cp-icon cp-bot-icon">ॐ</div>
      <div class="cp-typing-bubble"><div class="cp-td"></div><div class="cp-td"></div><div class="cp-td"></div></div>
    </div>
  </div>
  <div id="cpQuick">
    <button class="cp-qbtn" onclick="cpSendQuick('How do I have my first lucid dream?')">First lucid dream</button>
    <button class="cp-qbtn" onclick="cpSendQuick('What is Dream Yoga?')">Dream Yoga</button>
    <button class="cp-qbtn" onclick="cpSendQuick('Tell me about the app pricing')">Pricing</button>
  </div>
  <div id="cpInputArea">
    <textarea id="cpInput" placeholder="Ask Lumina..." rows="1"></textarea>
    <button id="cpSend" onclick="cpSend()">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7L13 1L9.5 7L13 13L1 7Z" fill="white"/></svg>
    </button>
  </div>
</div>

<script>
/* ═══════════════════════════════════════
   DREAM JOURNAL PANEL — JS (localStorage)
═══════════════════════════════════════ */
const DJP_KEY = 'lucid_om_dreams_v1';
let djpDreams = [];
let djpFilter = 'all';
let djpType = 'normal';
let djpThemes = [];
let djpClarity = 3;
let djpMood = 'Neutral';
const djpMoodColors = {Peaceful:'#67E8F9',Neutral:'#A5B4FC',Excited:'#C4B5FD',Anxious:'#FCA5A5',Sad:'#93C5FD',Inspired:'#6EE7B7'};
const djpClarityLabels = ['','Faint','Hazy','Medium','Clear','Crystal clear'];

function djpLoad() {
  try { djpDreams = JSON.parse(localStorage.getItem(DJP_KEY)) || []; } catch(e) { djpDreams = []; }
  if (!djpDreams.length) djpSeed();
  djpUpdateStats();
}

function djpSave() {
  const title = document.getElementById('djpWTitle').value.trim();
  const body  = document.getElementById('djpWBody').value.trim();
  if (!body) { document.getElementById('djpWBody').focus(); return; }
  djpDreams.unshift({ id:Date.now(), date:Date.now(), title:title||'Untitled dream', body, type:djpType, themes:[...djpThemes], clarity:djpClarity, mood:djpMood });
  try { localStorage.setItem(DJP_KEY, JSON.stringify(djpDreams)); } catch(e){}
  djpUpdateStats();
  document.getElementById('djpWTitle').value = '';
  document.getElementById('djpWBody').value = '';
  djpThemes=[]; djpType='normal'; djpClarity=3; djpMood='Neutral';
  document.querySelectorAll('.djp-chip').forEach(c=>c.classList.remove('on'));
  document.querySelectorAll('.djp-type-btn').forEach((b,i)=>b.classList.toggle('on',i===0));
  djpSetClarity(3);
  const msg = document.getElementById('djpSavedMsg');
  msg.style.display='block'; setTimeout(()=>msg.style.display='none',3000);
}

function djpSeed() {
  const now = Date.now(), day = 86400000;
  djpDreams = [
    {id:1,date:now-day*2,title:'The floating library',body:'I found myself in a vast library that was slowly lifting off the ground. The books were glowing softly. I became lucid when I noticed the floor was made of clouds. I flew between the shelves reading titles that kept changing.',type:'lucid',themes:['Flying','Light','Transformation'],clarity:4,mood:'Inspired'},
    {id:2,date:now-day*3,title:'The ocean that breathed',body:'Walking along a shoreline made of indigo sand. The waves moved in slow motion, each one breathing like a living thing. There was a temple in the distance I could never reach.',type:'vivid',themes:['Water','Unknown place'],clarity:5,mood:'Peaceful'},
    {id:3,date:now-day*5,title:'Chase through the market',body:'Running through an endless market. The stalls sold things I couldn\'t name. Someone was following me but I never saw their face.',type:'nightmare',themes:['Chasing','Fear'],clarity:3,mood:'Anxious'},
    {id:4,date:now-day,title:'The om mantra',body:'Sitting in deep meditation. A low humming sound grew until it filled everything. The sound became light, then became silence. I woke up with absolute stillness.',type:'spiritual',themes:['Om / Mantra','Light'],clarity:5,mood:'Peaceful'},
  ];
  try { localStorage.setItem(DJP_KEY, JSON.stringify(djpDreams)); } catch(e){}
}

function djpUpdateStats() {
  const l = djpDreams.filter(d=>d.type==='lucid').length;
  document.getElementById('djpTotal').textContent  = djpDreams.length;
  document.getElementById('djpLucid').textContent  = l;
  document.getElementById('djpStreak').textContent = djpCalcStreak();
}

function djpCalcStreak() {
  const dates = [...new Set(djpDreams.map(d=>new Date(d.date).toDateString()))];
  let s=0, cur=new Date();
  for(let i=0;i<30;i++){
    if(dates.includes(cur.toDateString())){ s++; cur.setDate(cur.getDate()-1); }
    else if(i===0){ cur.setDate(cur.getDate()-1); continue; }
    else break;
  }
  return s;
}

function openDreamJournal() {
  djpLoad();
  document.getElementById('djPanel').classList.add('dj-open');
  document.getElementById('djPanel').scrollTop = 0;
  document.body.style.overflow = 'hidden';
  djpRenderLog();
}

function closeDreamJournal() {
  document.getElementById('djPanel').classList.remove('dj-open');
  document.body.style.overflow = '';
}

function djpTab(t, btn) {
  document.querySelectorAll('.djp-tab').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  document.getElementById('djpLog').style.display     = t==='log'?'block':'none';
  document.getElementById('djpWrite').style.display   = t==='write'?'block':'none';
  document.getElementById('djpInsights').style.display= t==='insights'?'block':'none';
  if(t==='log') djpRenderLog();
  if(t==='insights') djpRenderInsights();
}

function djpSetFilter(f, btn) {
  djpFilter=f;
  document.querySelectorAll('.djp-filter').forEach(b=>b.classList.remove('on'));
  btn.classList.add('on');
  djpRenderLog();
}

function djpRenderLog() {
  const q = (document.getElementById('djpSearch').value||'').toLowerCase();
  const list = djpDreams.filter(d=>{
    const mf = djpFilter==='all'||d.type===djpFilter;
    const ms = !q||d.title.toLowerCase().includes(q)||d.body.toLowerCase().includes(q)||(d.themes||[]).some(t=>t.toLowerCase().includes(q));
    return mf && ms;
  }).sort((a,b)=>b.date-a.date);
  const el = document.getElementById('djpLogList');
  if(!list.length){ el.innerHTML='<div class="djp-empty">&#9790;<br><br>No dreams here yet.<br>Add your first entry in the + New Entry tab.</div>'; return; }
  el.innerHTML = list.map(d=>{
    const dt = new Date(d.date).toLocaleDateString('en-GB',{weekday:'short',day:'numeric',month:'short',year:'numeric'});
    const badges = [d.type,...(d.themes||[]).slice(0,2)].map(t=>`<span class="djp-badge djp-badge-${t.replace(/\s+/g,'').toLowerCase().slice(0,9)}">${t}</span>`).join('');
    const stars = d.clarity?'&#9733;'.repeat(d.clarity)+'&#9734;'.repeat(5-d.clarity):'';
    const sb = (d.body||'').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    const st = (d.title||'Untitled dream').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return `<div class="djp-card ${d.type}" onclick="djpToggleCard(${d.id})">
      <div class="djp-card-top"><div class="djp-card-date">${dt}</div><div class="djp-badges">${badges}</div></div>
      <div class="djp-card-title">${st}</div>
      <div class="djp-card-preview">${sb}</div>
      <div class="djp-card-footer">
        <div><span class="djp-mood-dot" style="display:inline-block;background:${djpMoodColors[d.mood]||'#A5B4FC'}"></span></div>
        <div style="font-size:12px;color:rgba(165,180,252,0.4)">${stars}</div>
      </div>
      <div class="djp-expand" id="djpe-${d.id}">
        <div class="djp-expand-text">${sb}</div>
        <div class="djp-meta">
          <div class="djp-meta-item">Mood: <span>${d.mood||'—'}</span></div>
          <div class="djp-meta-item">Clarity: <span>${d.clarity?d.clarity+'/5':'—'}</span></div>
          <div class="djp-meta-item">Themes: <span>${(d.themes||[]).join(', ')||'None'}</span></div>
        </div>
        <button class="djp-del" onclick="event.stopPropagation();djpDelete(${d.id})">Delete entry</button>
      </div>
    </div>`;
  }).join('');
}

function djpToggleCard(id) { const el=document.getElementById('djpe-'+id); if(el) el.classList.toggle('open'); }

function djpDelete(id) {
  if(!confirm('Remove this dream from your journal?')) return;
  djpDreams = djpDreams.filter(d=>d.id!==id);
  try{localStorage.setItem(DJP_KEY,JSON.stringify(djpDreams));}catch(e){}
  djpUpdateStats(); djpRenderLog();
}

function djpSetType(t,btn) {
  djpType=t;
  document.querySelectorAll('.djp-type-btn').forEach(b=>{ if(['Normal','Lucid','Vivid','Nightmare','Spiritual','Recurring'].includes(b.textContent)) b.classList.toggle('on',b.textContent.toLowerCase()===t); });
  btn.classList.add('on');
}

function djpToggleTheme(btn,theme) {
  btn.classList.toggle('on');
  djpThemes = btn.classList.contains('on') ? [...new Set([...djpThemes,theme])] : djpThemes.filter(t=>t!==theme);
}

function djpSetClarity(n) {
  djpClarity=n;
  document.querySelectorAll('#djpStars .djp-star').forEach((s,i)=>s.classList.toggle('on',i<n));
  document.getElementById('djpClarityLbl').textContent = djpClarityLabels[n]||'';
}

function djpSetMood(m,btn) {
  djpMood=m;
  document.querySelectorAll('.djp-type-btn').forEach(b=>{ if(['Peaceful','Neutral','Excited','Anxious','Sad','Inspired'].includes(b.textContent)) b.classList.toggle('on',b.textContent===m); });
  btn.classList.add('on');
}

function djpRenderInsights() {
  const total=djpDreams.length, lucid=djpDreams.filter(d=>d.type==='lucid').length;
  const pct=total?Math.round(lucid/total*100):0;
  const avgC=total?(djpDreams.reduce((a,d)=>a+(d.clarity||3),0)/total).toFixed(1):'0';
  document.getElementById('djpInsTotal').textContent=total;
  document.getElementById('djpInsLucid').textContent=lucid;
  document.getElementById('djpInsPct').textContent=pct+'% of total';
  document.getElementById('djpInsStreak').textContent=djpCalcStreak();
  document.getElementById('djpInsClarity').textContent=avgC;
  // Streak dots
  const allDates=new Set(djpDreams.map(d=>new Date(d.date).toDateString()));
  const lucidDates=new Set(djpDreams.filter(d=>d.type==='lucid').map(d=>new Date(d.date).toDateString()));
  const today=new Date(); let sdHtml='';
  for(let i=27;i>=0;i--){
    const d=new Date(today); d.setDate(d.getDate()-i);
    const ds=d.toDateString();
    const cls=lucidDates.has(ds)?'lucid-d':allDates.has(ds)?'has':'';
    const tc=i===0?'today':'';
    sdHtml+=`<div class="djp-sday ${cls} ${tc}">${d.getDate()}</div>`;
  }
  document.getElementById('djpStreakDots').innerHTML=sdHtml;
  // Themes
  const tc={};
  djpDreams.forEach(d=>(d.themes||[]).forEach(t=>{tc[t]=(tc[t]||0)+1}));
  const sorted=Object.entries(tc).sort((a,b)=>b[1]-a[1]).slice(0,10);
  document.getElementById('djpThemeCloud').innerHTML=sorted.length?sorted.map(([t,n])=>`<span class="djp-theme-item">${t} <span style="opacity:0.5">${n}</span></span>`).join(''):'<span style="color:rgba(165,180,252,0.28);font-size:13px">No themes yet</span>';
  // Mood bars
  const mc={};
  djpDreams.forEach(d=>{if(d.mood)mc[d.mood]=(mc[d.mood]||0)+1});
  document.getElementById('djpMoodBars').innerHTML=Object.entries(mc).sort((a,b)=>b[1]-a[1]).map(([m,n])=>{
    const p=Math.round(n/(total||1)*100);
    return `<div style="display:flex;align-items:center;gap:8px;margin-bottom:7px"><span style="font-size:12px;color:rgba(165,180,252,0.5);width:64px;flex-shrink:0">${m}</span><div style="flex:1;height:5px;background:rgba(165,180,252,0.07);border-radius:3px;overflow:hidden"><div style="height:100%;width:${p}%;background:${djpMoodColors[m]||'#A5B4FC'};border-radius:3px;transition:width 0.5s ease"></div></div><span style="font-size:11px;color:rgba(165,180,252,0.35);width:28px;text-align:right">${p}%</span></div>`;
  }).join('')||'<span style="color:rgba(165,180,252,0.28);font-size:13px">No moods yet</span>';
}

// Esc closes
document.addEventListener('keydown', e=>{
  if(e.key==='Escape'&&document.getElementById('djPanel').classList.contains('dj-open')) closeDreamJournal();
});

/* ═══════════════════════════════════════
   CHATBOT — FLOATING PANEL JS
═══════════════════════════════════════ */
let cpMsgs = [], cpBusy = false, cpIsOpen = false;

const CP_SYSTEM = `You are Lumina, the AI guide for Lucid Om — a premium conscious dreaming app combining modern lucid dreaming science with authentic Tibetan Dream Yoga (Milam). You know: MILD, WILD, WBTB, SSILD, reality checks, Tibetan Dream Yoga (Six Yogas of Naropa, Milam, Illusory Body, Clear Light), the Lucid Om app (free: 7-Day Challenge, guided meditation, Reality Check Pack; premium: $125/month or $1,200/year; Mastery Program: $497). Be calm, warm, poetic, wise. Use **bold** for key terms, *italics* for evocative phrases. Keep replies to 2-3 short paragraphs. Never pushy.`;

function toggleChat() {
  cpIsOpen = !cpIsOpen;
  document.getElementById('chatPanel').classList.toggle('cp-open', cpIsOpen);
  if(cpIsOpen) { document.getElementById('cpInput').focus(); }
}

function cpAutoSize() {
  const el = document.getElementById('cpInput');
  el.style.height='auto';
  el.style.height=Math.min(el.scrollHeight,80)+'px';
}

document.getElementById('cpInput').addEventListener('input', cpAutoSize);
document.getElementById('cpInput').addEventListener('keydown', e=>{
  if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();cpSend();}
});

function cpAddMsg(role, html) {
  const isUser = role==='user';
  const row = document.createElement('div');
  row.className = 'cp-row '+(isUser?'user':'bot');
  const icon = document.createElement('div');
  icon.className = 'cp-icon '+(isUser?'cp-user-icon':'cp-bot-icon');
  icon.textContent = isUser?'You':'ॐ';
  const bubble = document.createElement('div');
  bubble.className = 'cp-bubble '+(isUser?'cp-user-bubble':'cp-bot-bubble');
  bubble.innerHTML = html;
  row.appendChild(icon); row.appendChild(bubble);
  const msgsEl = document.getElementById('cpMsgs');
  msgsEl.insertBefore(row, document.getElementById('cpTyping'));
  msgsEl.scrollTop = msgsEl.scrollHeight;
}

function cpShowTyping(show) {
  const t = document.getElementById('cpTyping');
  t.style.display = show?'flex':'none';
  if(show) { const m=document.getElementById('cpMsgs'); m.scrollTop=m.scrollHeight; }
}

function cpFmt(text) {
  return text.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/\*(.+?)\*/g,'<em>$1</em>').replace(/\n\n/g,'<br><br>').replace(/\n/g,'<br>');
}

async function cpSend() {
  const text = document.getElementById('cpInput').value.trim();
  if(!text||cpBusy) return;
  document.getElementById('cpInput').value='';
  cpAutoSize();
  document.getElementById('cpQuick').style.display='none';
  cpBusy=true; document.getElementById('cpSend').disabled=true;
  cpAddMsg('user', text.replace(/</g,'&lt;').replace(/>/g,'&gt;'));
  cpMsgs.push({role:'user',content:text});
  cpShowTyping(true);
  try {
    const res = await fetch('https://api.anthropic.com/v1/messages',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:'claude-sonnet-4-20250514',max_tokens:800,system:CP_SYSTEM,messages:cpMsgs})});
    const data = await res.json();
    cpShowTyping(false);
    const reply = data.content&&data.content[0]&&data.content[0].text?data.content[0].text:'A quiet ripple in the dream space. Please try again.';
    cpMsgs.push({role:'assistant',content:reply});
    cpAddMsg('bot', cpFmt(reply));
  } catch(e) {
    cpShowTyping(false);
    cpAddMsg('bot','<em>A ripple in the dream space...</em> Connection lost. Please try again.');
  }
  cpBusy=false; document.getElementById('cpSend').disabled=false;
  document.getElementById('cpInput').focus();
}

function cpSendQuick(text) { document.getElementById('cpInput').value=text; cpSend(); }

</script>
</body>
</html>
