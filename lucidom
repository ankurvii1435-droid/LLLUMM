<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lucid Om — Wake Up In Your Dreams</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
/* ═══════════════════════════════════════
   DESIGN TOKENS & RESET
═══════════════════════════════════════ */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

:root {
  --void:    #0A0F1E;
  --nebula:  #4F46E5;
  --aura:    #A5B4FC;
  --mist:    #E0E7FF;
  --teal:    #67E8F9;
  --fog:     #F1E7D9;
  --softbg:  #1E2937;
  --ww:      #FDFCFF;
  --ow:      #F8F6FF;
  --ink:     #12102B;
  --ink-60:  rgba(18,16,43,0.60);
  --ink-35:  rgba(18,16,43,0.35);
  --ink-18:  rgba(18,16,43,0.08);
  --card-w:  #FFFFFF;
  --r-pill:  50px;
  --r-card:  22px;
  --shadow-sm: 0 2px 16px rgba(79,70,229,0.06), 0 1px 3px rgba(0,0,0,0.04);
  --shadow-md: 0 6px 32px rgba(79,70,229,0.10), 0 2px 8px rgba(0,0,0,0.05);
  --shadow-lg: 0 12px 56px rgba(79,70,229,0.16), 0 4px 16px rgba(0,0,0,0.08);
  --shadow-glow: 0 0 40px rgba(79,70,229,0.28), 0 8px 40px rgba(79,70,229,0.18);
}

body {
  background: var(--ww);
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ═══════════════ TYPOGRAPHY ═══════════════ */
.f-display { font-family: 'Cinzel', serif; }
.f-serif   { font-family: 'Cormorant Garamond', serif; }

.g-hero  { background: linear-gradient(135deg,#A5B4FC 0%,#E0E7FF 45%,#67E8F9 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.g-soft  { background: linear-gradient(135deg,#4F46E5 0%,#8B5CF6 55%,#06B6D4 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.g-teal  { background: linear-gradient(135deg,#67E8F9 0%,#A5B4FC 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.g-mist  { background: linear-gradient(135deg,#A5B4FC 0%,#E0E7FF 60%,#67E8F9 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

/* ═══════════════ SECTION LABELS ═══════════════ */
.lbl {
  display: block;
  font-size: 11px;
  letter-spacing: 5px;
  font-weight: 400;
  text-transform: uppercase;
  margin-bottom: 16px;
}
.lbl-light { color: rgba(165,180,252,0.55); }
.lbl-dark  { color: rgba(79,70,229,0.52); }

/* ═══════════════ BUTTONS ═══════════════ */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 36px;
  border-radius: var(--r-pill);
  font-family: 'DM Sans', sans-serif;
  font-weight: 400;
  font-size: 15px;
  letter-spacing: 0.4px;
  cursor: pointer;
  transition: all 0.32s ease;
  text-decoration: none;
  white-space: nowrap;
}
.btn-indigo {
  background: linear-gradient(135deg,#4F46E5,#6D63F0);
  color: #fff;
  border: none;
  box-shadow: 0 4px 24px rgba(79,70,229,0.28);
}
.btn-indigo:hover { transform: translateY(-2px); box-shadow: var(--shadow-glow); }

.btn-teal {
  background: linear-gradient(135deg,#0891B2,#06B6D4);
  color: #fff;
  border: none;
  box-shadow: 0 4px 20px rgba(6,182,212,0.28);
}
.btn-teal:hover { transform: translateY(-2px); box-shadow: 0 8px 36px rgba(6,182,212,0.38); }

.btn-fog {
  background: var(--fog);
  color: #4A3728;
  border: 1px solid rgba(180,150,120,0.25);
}
.btn-fog:hover { background: #ECD5BE; transform: translateY(-2px); box-shadow: 0 6px 24px rgba(180,150,120,0.2); }

.btn-outline {
  background: transparent;
  color: var(--nebula);
  border: 1.5px solid rgba(79,70,229,0.38);
}
.btn-outline:hover { background: rgba(79,70,229,0.06); border-color: var(--nebula); box-shadow: 0 4px 20px rgba(79,70,229,0.12); transform: translateY(-1px); }

.btn-ghost-light {
  background: rgba(255,255,255,0.1);
  color: #E0E7FF;
  border: 1px solid rgba(165,180,252,0.38);
  backdrop-filter: blur(8px);
}
.btn-ghost-light:hover { background: rgba(255,255,255,0.18); border-color: rgba(165,180,252,0.65); }

.btn-outline-light {
  background: transparent;
  color: #A5B4FC;
  border: 1.5px solid rgba(165,180,252,0.35);
}
.btn-outline-light:hover { background: rgba(165,180,252,0.1); border-color: rgba(165,180,252,0.6); }

.btn-gold {
  background: linear-gradient(135deg,#C9A96E,#E8C87A,#C9A96E);
  color: #2A1F00;
  border: none;
  box-shadow: 0 4px 20px rgba(201,169,110,0.3);
  font-weight: 500;
}
.btn-gold:hover { transform: translateY(-2px); box-shadow: 0 8px 36px rgba(201,169,110,0.45); }

.btn-sm { padding: 11px 26px; font-size: 13px; }
.btn-lg { padding: 17px 48px; font-size: 16px; }

/* ═══════════════ DIVIDERS ═══════════════ */
.div-glow { height:1px; background:linear-gradient(90deg,transparent,rgba(79,70,229,0.15),transparent); max-width:700px; margin:0 auto; }
.div-glow-wide { height:1px; background:linear-gradient(90deg,transparent,rgba(79,70,229,0.18),rgba(165,180,252,0.12),transparent); }

/* ═══════════════ PILL TAGS ═══════════════ */
.pill { display:inline-block; padding:4px 13px; border-radius:20px; font-size:11px; letter-spacing:0.8px; font-weight:400; }
.pill-purple { background:rgba(79,70,229,0.08); color:var(--nebula); border:1px solid rgba(79,70,229,0.18); }
.pill-teal   { background:rgba(6,182,212,0.08); color:#0891B2; border:1px solid rgba(6,182,212,0.2); }
.pill-fog    { background:rgba(241,231,217,0.6); color:#6B5644; border:1px solid rgba(180,150,120,0.25); }
.pill-green  { background:rgba(16,185,129,0.08); color:#059669; border:1px solid rgba(16,185,129,0.2); }
.pill-gold   { background:rgba(201,169,110,0.15); color:#92700A; border:1px solid rgba(201,169,110,0.3); }

/* ═══════════════ CARDS ═══════════════ */
.card-white {
  background: var(--card-w);
  border: 1px solid rgba(79,70,229,0.09);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-sm);
  transition: all 0.36s ease;
}
.card-white:hover { border-color:rgba(79,70,229,0.22); box-shadow:var(--shadow-lg); transform:translateY(-3px); }

.card-dark {
  background: linear-gradient(145deg,#181530 0%,#0E1224 100%);
  border: 1px solid rgba(165,180,252,0.11);
  border-radius: var(--r-card);
  transition: all 0.36s ease;
}
.card-dark:hover { border-color:rgba(165,180,252,0.24); box-shadow:0 8px 40px rgba(79,70,229,0.22); transform:translateY(-3px); }

.card-glow {
  background: linear-gradient(145deg,rgba(79,70,229,0.12) 0%,rgba(10,15,30,0.95) 100%);
  border: 1px solid rgba(79,70,229,0.28);
  border-radius: var(--r-card);
  box-shadow: 0 0 32px rgba(79,70,229,0.15), inset 0 1px 0 rgba(165,180,252,0.12);
  transition: all 0.36s ease;
}
.card-glow:hover { box-shadow:0 0 56px rgba(79,70,229,0.25),inset 0 1px 0 rgba(165,180,252,0.18); transform:translateY(-3px); }

.card-lavender {
  background: linear-gradient(145deg,rgba(165,180,252,0.12),rgba(103,232,249,0.05));
  border: 1px solid rgba(165,180,252,0.22);
  border-radius: var(--r-card);
  transition: all 0.36s ease;
}
.card-lavender:hover { background:linear-gradient(145deg,rgba(165,180,252,0.18),rgba(103,232,249,0.08)); border-color:rgba(165,180,252,0.38); box-shadow:var(--shadow-md); transform:translateY(-2px); }

.card-fog-warm {
  background: linear-gradient(145deg,rgba(241,231,217,0.55),rgba(230,215,195,0.3));
  border: 1px solid rgba(180,150,120,0.22);
  border-radius: var(--r-card);
  transition: all 0.36s ease;
}
.card-fog-warm:hover { border-color:rgba(180,150,120,0.4); box-shadow:0 8px 32px rgba(180,150,120,0.15); transform:translateY(-2px); }

/* ═══════════════ CHECK LIST ═══════════════ */
.check-list { list-style: none; display:flex; flex-direction:column; gap:11px; }
.check-list li { display:flex; align-items:flex-start; gap:10px; font-size:14px; line-height:1.6; }
.check-list li::before {
  content: '';
  display: block;
  width: 18px; height: 18px;
  border-radius: 50%;
  background: linear-gradient(135deg,#4F46E5,#06B6D4);
  flex-shrink: 0;
  margin-top: 2px;
  background-image: url("data:image/svg+xml,%3Csvg width='10' height='8' viewBox='0 0 10 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4l3 3 5-6' stroke='%23fff' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' fill='none'/%3E%3C/svg%3E");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 10px;
  background-color: linear-gradient(135deg,#4F46E5,#06B6D4);
}
.check-dark li { color: rgba(165,180,252,0.65); }
.check-dark li::before { background-color: rgba(79,70,229,0.7); }
.check-light li { color: var(--ink-60); }

/* ═══════════════ POPULAR BADGE ═══════════════ */
.badge-popular {
  display:inline-block;
  background:linear-gradient(135deg,#4F46E5,#7C3AED);
  color:#fff;
  font-size:10px;
  letter-spacing:2px;
  padding:4px 14px;
  border-radius:20px;
  font-weight:500;
  box-shadow:0 3px 14px rgba(79,70,229,0.4);
}
.badge-gold {
  display:inline-block;
  background:linear-gradient(135deg,#C9A96E,#E8C87A);
  color:#2A1F00;
  font-size:10px;
  letter-spacing:2px;
  padding:4px 14px;
  border-radius:20px;
  font-weight:500;
  box-shadow:0 3px 12px rgba(201,169,110,0.35);
}

/* ═══════════════ PRICING TOGGLE ═══════════════ */
.toggle-wrap {
  display:inline-flex;
  background:rgba(79,70,229,0.08);
  border:1px solid rgba(79,70,229,0.15);
  border-radius:50px;
  padding:4px;
  gap:4px;
}
.toggle-opt {
  padding:8px 22px;
  border-radius:50px;
  font-size:14px;
  cursor:pointer;
  transition:all 0.28s ease;
  color: var(--ink-60);
  font-family:'DM Sans',sans-serif;
  border:none;
  background:transparent;
}
.toggle-opt.active {
  background:#fff;
  color: var(--nebula);
  box-shadow: 0 2px 10px rgba(79,70,229,0.12);
  font-weight:500;
}

/* ═══════════════ SAVINGS CHIP ═══════════════ */
.savings-chip {
  display:inline-block;
  background:linear-gradient(135deg,rgba(16,185,129,0.15),rgba(16,185,129,0.08));
  color:#059669;
  border:1px solid rgba(16,185,129,0.25);
  font-size:11px;
  letter-spacing:0.5px;
  padding:3px 11px;
  border-radius:20px;
}

/* ═══════════════ FREE CARD ICON ═══════════════ */
.free-icon {
  width:64px; height:64px;
  border-radius:18px;
  display:flex; align-items:center; justify-content:center;
  font-size:28px;
  margin-bottom:24px;
  flex-shrink:0;
}

/* ═══════════════ NAV ═══════════════ */
nav {
  position: fixed;
  top:0; left:0; right:0;
  z-index: 1000;
  padding: 22px 52px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.4s ease;
}
nav.n-dark {
  background: linear-gradient(180deg,rgba(10,15,30,0.88),transparent);
  backdrop-filter: blur(12px);
}
nav.n-light {
  background: rgba(253,252,255,0.94);
  backdrop-filter: blur(24px);
  border-bottom: 1px solid rgba(79,70,229,0.07);
  padding: 15px 52px;
  box-shadow: 0 2px 20px rgba(79,70,229,0.05);
}
.nav-logo { font-size:18px; letter-spacing:3.5px; font-weight:500; transition:color 0.4s; }

/* ═══════════════ HERO ═══════════════ */
.hero {
  min-height:100vh;
  background:var(--void);
  position:relative;
  overflow:hidden;
  display:flex; flex-direction:column;
  align-items:center; justify-content:center;
  padding:120px 24px 100px;
  text-align:center;
}
#sf { position:absolute; inset:0; pointer-events:none; z-index:0; opacity:0.8; }

/* ═══════════════ WAVE TRANSITIONS ═══════════════ */
.wave-d2w { background:var(--void); line-height:0; margin-bottom:-2px; }
.wave-w2d { line-height:0; margin-bottom:-2px; }

/* ═══════════════ SCROLL REVEAL ═══════════════ */
.reveal {
  opacity:0; transform:translateY(24px);
  transition:opacity 0.75s ease, transform 0.75s ease;
}
.reveal.in { opacity:1; transform:translateY(0); }

/* ═══════════════ ANIMATIONS ═══════════════ */
@keyframes float      { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }
@keyframes moonPulse  { 0%,100%{filter:drop-shadow(0 0 18px rgba(165,180,252,0.5))} 50%{filter:drop-shadow(0 0 44px rgba(165,180,252,0.9))} }
@keyframes twinkle    { 0%,100%{opacity:.12} 50%{opacity:1} }
@keyframes fadeUp     { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
@keyframes shimmer    { 0%,100%{opacity:.25} 50%{opacity:.7} }
@keyframes orbDrift   { 0%,100%{transform:translate(0,0)} 50%{transform:translate(14px,-18px)} }
@keyframes spinSlow   { to{transform:rotate(360deg)} }
@keyframes pulseRing  { 0%{transform:scale(0.96);opacity:.6} 50%{transform:scale(1.02);opacity:1} 100%{transform:scale(0.96);opacity:.6} }

.moon-float { animation:float 7s ease-in-out infinite; }
.moon-glow  { animation:moonPulse 4s ease-in-out infinite; }
.au1 { animation:fadeUp 1s ease 0.1s both; }
.au2 { animation:fadeUp 1s ease 0.4s both; }
.au3 { animation:fadeUp 1s ease 0.7s both; }

/* ═══════════════ SCROLLBAR ═══════════════ */
::-webkit-scrollbar { width:4px; }
::-webkit-scrollbar-track { background:var(--ow); }
::-webkit-scrollbar-thumb { background:rgba(79,70,229,0.22); border-radius:2px; }

/* ═══════════════ STAT NUMBER ═══════════════ */
.stat-n { font-family:'Cinzel',serif; font-size:42px; font-weight:500; line-height:1; background:linear-gradient(135deg,#4F46E5,#7C3AED); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }

/* ═══════════════ FREE OFFERING — ACCENT LINE ═══════════════ */
.free-accent { width:36px; height:3px; border-radius:2px; margin-bottom:16px; }

/* ═══════════════ PRICING CARD FEATURED ═══════════════ */
.pricing-featured {
  background: linear-gradient(145deg,#151228 0%,#0D1020 100%);
  border: 1.5px solid rgba(79,70,229,0.45);
  border-radius: var(--r-card);
  box-shadow: 0 0 0 4px rgba(79,70,229,0.07), var(--shadow-glow);
  position:relative;
  overflow:hidden;
}
.pricing-featured::before {
  content:'';
  position:absolute;
  top:0; left:0; right:0; height:2px;
  background:linear-gradient(90deg,#4F46E5,#8B5CF6,#67E8F9);
}

/* ═══════════════ MASTERY CARD ═══════════════ */
.mastery-card {
  background: linear-gradient(145deg,rgba(201,169,110,0.08) 0%,rgba(10,15,30,0.98) 100%);
  border: 1.5px solid rgba(201,169,110,0.35);
  border-radius: var(--r-card);
  position:relative;
  overflow:hidden;
}
.mastery-card::before {
  content:'';
  position:absolute;
  top:0; left:0; right:0; height:2px;
  background:linear-gradient(90deg,#C9A96E,#E8C87A,#C9A96E);
}

/* ═══════════════ SECTION BACKGROUNDS ═══════════════ */
.bg-void    { background:var(--void); }
.bg-ww      { background:var(--ww); }
.bg-ow      { background:var(--ow); }
.bg-fog-section { background:linear-gradient(180deg,#FAF7FF 0%,#F2EDF9 100%); }
.bg-dark-soft { background:linear-gradient(180deg,#0D1022 0%,#0A0F1E 100%); }

/* ═══════════════ COMPARISON TABS ═══════════════ */
.tab-bar {
  display:inline-flex;
  background:rgba(79,70,229,0.07);
  border:1px solid rgba(79,70,229,0.13);
  border-radius:50px;
  padding:5px;
  gap:4px;
}
.tab-btn {
  padding:10px 28px;
  border-radius:50px;
  font-size:14px;
  cursor:pointer;
  transition:all 0.28s ease;
  color:var(--ink-60);
  font-family:'DM Sans',sans-serif;
  border:none;
  background:transparent;
  font-weight:400;
}
.tab-btn.on {
  background:var(--nebula);
  color:#fff;
  box-shadow:0 3px 14px rgba(79,70,229,0.32);
  font-weight:500;
}

/* ═══════════════ RESPONSIVE ═══════════════ */
@media(max-width:1024px) {
  .grid-2 { grid-template-columns:1fr !important; }
}
@media(max-width:768px) {
  nav { padding:16px 20px; }
  nav.n-light { padding:12px 20px; }
  .hide-mob { display:none !important; }
  .show-mob { display:block !important; }
  .hero { padding:100px 20px 80px; }
  .sec { padding:80px 20px !important; }
}
@media(max-width:540px) {
  .cta-row { flex-direction:column; align-items:stretch !important; }
  .cta-row .btn { text-align:center; justify-content:center; }
}

/* ═══════════════ NOISE OVERLAY ═══════════════ */
body::after {
  content:'';
  position:fixed; inset:0;
  opacity:0.018;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size:200px;
  pointer-events:none;
  z-index:9999;
}
</style>
</head>
<body>

<!-- ═══════════════════════════════════════
     NAV
═══════════════════════════════════════ -->
<nav id="nav" class="n-dark">
  <div id="nLogo" class="f-display nav-logo" style="color:#E0E7FF;">LUCID OM</div>

  <div id="nLinks" class="hide-mob" style="display:flex;gap:32px;align-items:center;">
    <a href="#free" class="nl" style="font-size:14px;text-decoration:none;color:rgba(165,180,252,0.75);letter-spacing:0.4px;transition:color 0.28s;">Free</a>
    <a href="#premium" class="nl" style="font-size:14px;text-decoration:none;color:rgba(165,180,252,0.75);letter-spacing:0.4px;transition:color 0.28s;">Premium</a>
    <a href="#techniques" class="nl" style="font-size:14px;text-decoration:none;color:rgba(165,180,252,0.75);letter-spacing:0.4px;transition:color 0.28s;">Techniques</a>
    <a href="#community" class="nl" style="font-size:14px;text-decoration:none;color:rgba(165,180,252,0.75);letter-spacing:0.4px;transition:color 0.28s;">Community</a>
    <button onclick="openDreamJournal()" class="nl" style="font-size:14px;background:none;border:none;cursor:pointer;color:rgba(165,180,252,0.75);letter-spacing:0.4px;transition:color 0.28s;font-family:inherit;padding:0;" onmouseover="this.style.color='#E0E7FF'" onmouseout="this.style.color='rgba(165,180,252,0.75)'">Dream Journal</button>
    <a href="#premium" class="btn btn-indigo btn-sm">Start Free Trial</a>
  </div>
  <button id="mBtn" onclick="toggleMenu()" class="show-mob" style="display:none;background:none;border:none;cursor:pointer;font-size:22px;color:#A5B4FC;">☰</button>
</nav>

<!-- ═══════════════════════════════════════
     HERO — Deep Night Sky
═══════════════════════════════════════ -->
<section class="hero">
  <canvas id="sf"></canvas>

  <!-- Nebula orbs -->
